node_modules/
dist/
__pycache__/
*.pyc
.DS_Store
*.log

# Vendored third-party binary (253MB) — install separately, see STATUS.md
services/cad-interop/oda/

# SQLite write-ahead-log temp files (data.sqlite itself IS committed — it holds demo seed data)
*.sqlite-shm
*.sqlite-wal

# Runtime per-project data (uploaded CAD files, generated geometry/layouts/exports) —
# user-generated at runtime, not source. See services/zoning-engine/storage.py.
services/zoning-engine/storage/*/

# Timestamped safety-net backups written before every admin-UI rules-registry
# save (see rules_registry.py's save_category) — runtime recovery files, not
# source; the current registry itself stays committed as normal.
services/rules-config/registry/*.backup.*.json
